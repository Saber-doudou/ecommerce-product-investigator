# ecommerce-product-investigator 环境变量配置
#
# 复制此文件为 .env 并填入你的实际值：
#   cp .env.example .env

# ── 买手 88 API 配置（必须） ──
# 从 maishou88.com 获取 API 邀请码
MAISHOU_API_KEY=your_api_key_here

# 从 maishou88.com 获取用户 OpenID
MAISHOU_OPENID=your_openid_here
# 注意：凭据入口 www.maishou88.com 于 2026-11-05 实测 TLS 证书过期。
# 获取前请先按 SKILL.md「事实校验锚」复核入口可用性。
